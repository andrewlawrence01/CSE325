@model AndrewsMovies.Models.MovieGenreViewModel

@{
    ViewData["Title"] = "My Movies";
}

<h1>My Movies</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">
        Add a Movie
    </a>
</p>

<form asp-controller="Movies"
      asp-action="Index"
      method="get"
      class="movie-search">

    <div class="form-group">
        <label for="searchString">Movie title</label>
        <input type="text"
               id="searchString"
               name="searchString"
               value="@Model.SearchString"
               placeholder="Search titles" />
    </div>

    <div class="form-group">
        <label for="movieGenre">Genre</label>
        <select id="movieGenre"
                name="movieGenre"
                asp-items="Model.Genres">
            <option value="">All genres</option>
        </select>
    </div>

    <div class="form-group">
        <label for="minYear">Released in or after</label>
        <select id="minYear" name="minYear">
            <option value="">Any year</option>
            @for (int year = DateTime.Now.Year; year >= 1900; year--)
            {
                <option value="@year"
                        selected="@(Model.MinYear == year)">
                    @year
                </option>
            }
        </select>
    </div>

    <button type="submit" class="btn btn-primary">
        Search
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Clear
    </a>
</form>

<table class="table">
    <thead>
        <tr>
            <th>Title</th>
            <th>Release Date</th>
            <th>Genre</th>
            <th>Price</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var movie in Model.Movies)
        {
            <tr>
                <td>@movie.Title</td>
                <td>@movie.ReleaseDate.ToString("yyyy-MM-dd")</td>
                <td>@movie.Genre</td>
                <td>@movie.Price.ToString("C")</td>
                <td>
                    <a asp-action="Edit"
                       asp-route-id="@movie.Id">Edit</a> |
                    <a asp-action="Details"
                       asp-route-id="@movie.Id">Details</a> |
                    <a asp-action="Delete"
                       asp-route-id="@movie.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>